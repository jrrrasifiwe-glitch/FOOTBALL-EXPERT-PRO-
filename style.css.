
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #07111f;
  color: #ffffff;
}

header {
  background: linear-gradient(135deg, #071b30, #087c50);
  text-align: center;
  padding: 35px 15px;
  border-bottom: 3px solid #00e676;
}

header h1 {
  font-size: 27px;
  color: #00e676;
}

header p {
  margin-top: 12px;
  color: #d0e5dc;
}

main {
  max-width: 950px;
  margin: auto;
  padding: 20px;
}

section {
  background: #122238;
  padding: 22px;
  margin: 20px 0;
  border-radius: 14px;
  border: 1px solid #263e56;
}

h2 {
  color: #00e676;
  margin-bottom: 16px;
}

.welcome {
  text-align: center;
  background: linear-gradient(135deg, #123c36, #142b45);
}

.matches {
  min-height: 150px;
}

#matches {
  color: #b8c9d8;
  padding: 12px 0;
}

#analysis {
  min-height: 180px;
}

footer {
  text-align: center;
  padding: 25px 10px;
  color: #91a5b8;
  background: #050c16;
  font-size: 13px;
  line-height: 1.8;
}

button {
  background: #00c96b;
  color: #07111f;
  border: none;
  padding: 12px 18px;
  border-radius: 8px;
  font-weight: bold;
  cursor: pointer;
}

button:hover {
  background: #00e676;
}

@media (max-width: 600px) {
  header h1 {
    font-size: 21px;
  }

  main {
    padding: 12px;
  }

  section {
    padding: 16px;
  }
}
