
const matchesContainer = document.getElementById("matches");
const analysisContainer = document.getElementById("analysis");

// Chargement des matchs réels depuis une source publique
async function loadMatches() {
  matchesContainer.innerHTML = "Chargement des matchs réels...";

  try {
    const response = await fetch(
      "https://www.thesportsdb.com/api/v1/json/3/eventsnextleague.php?id=4328"
    );

    if (!response.ok) throw new Error("Source indisponible");

    const data = await response.json();
    const matches = data.events || [];

    if (matches.length === 0) {
      matchesContainer.innerHTML = "Aucun match disponible actuellement.";
      return;
    }

    matchesContainer.innerHTML = "";

    matches.forEach((match) => {
      const card = document.createElement("div");
      card.style.cssText =
        "background:#1b3049;padding:15px;margin:12px 0;border-radius:10px;";

      const name = document.createElement("h3");
      name.textContent =
        `${match.strHomeTeam} - ${match.strAwayTeam}`;

      const date = document.createElement("p");
      date.textContent =
        `${match.dateEvent || ""} ${match.strTime || ""}`;

      const button = document.createElement("button");
      button.textContent = "ANALYSER CE MATCH";
      button.addEventListener("click", () => analyzeMatch(match));

      card.append(name, date, button);
      matchesContainer.appendChild(card);
    });
  } catch (error) {
    matchesContainer.textContent =
      "Impossible de charger les matchs. Réessaie plus tard.";
  }
}

// Analyse statistique indicative
function analyzeMatch(match) {
  analysisContainer.innerHTML = "";

  const title = document.createElement("h2");
  title.textContent =
    `${match.strHomeTeam} vs ${match.strAwayTeam}`;

  const info = document.createElement("p");
  info.textContent =
    "Analyse indicative : les statistiques historiques détaillées ne sont pas encore connectées.";

  const scoresTitle = document.createElement("h3");
  scoresTitle.textContent = "10 scénarios de scores exacts";

  const scores = [
    "1 - 0", "1 - 1", "2 - 1", "2 - 0", "0 - 0",
    "0 - 1", "2 - 2", "3 - 1", "1 - 2", "3 - 0"
  ];

  const list = document.createElement("ol");

  scores.forEach((score) => {
    const item = document.createElement("li");
    item.textContent = score;
    list.appendChild(item);
  });

  const advice = document.createElement("p");
  advice.textContent =
    "Conseil : attendre les statistiques des équipes avant de choisir un pari. Aucun pari garanti.";

  analysisContainer.append(title, info, scoresTitle, list, advice);
}

loadMatches();
